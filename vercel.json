{
  "rewrites": [
    { "source": "/", "destination": "/demo/index.html" },
    { "source": "/app.js", "destination": "/demo/app.js" },
    { "source": "/style.css", "destination": "/demo/style.css" },
    { "source": "/favicon.svg", "destination": "/demo/favicon.svg" },
    { "source": "/herkos-mark.svg", "destination": "/demo/herkos-mark.svg" },
    { "source": "/docs/:path*", "destination": "/docs/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
